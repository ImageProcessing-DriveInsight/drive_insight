+"""main.py end to end with synthetic frames and a stand-in VLM (no data, no model)."""
+import csv
+
+import pytest
+
+import main
+
+
+def fake_response(*args, **kwargs):
+    return {
+        "vehicles": ["car"],
+        "events": [{"order": 1, "content": "car ahead", "frame": 1}],
+        "visibility_notes": ["fog"],
+        "uncertain": [],
+    }
+
+
+@pytest.fixture
+def project(tmp_path, monkeypatch):
+    for condition in main.CONDITIONS:
+        folder = tmp_path / "data" / "frames" / condition
+        folder.mkdir(parents=True)
+        for ms in (100, 500):
+            (folder / f"clip01_{ms}.png").write_bytes(b"x")
+
+    results = tmp_path / "results"
+    vlm = results / "vlm"
+    monkeypatch.setattr(main, "FRAMES_DIR", tmp_path / "data" / "frames")
+    monkeypatch.setattr(main, "RESULTS_DIR", results)
+    monkeypatch.setattr(main, "LABELS_DIR", tmp_path / "data" / "labels")
+    monkeypatch.setattr(main, "VLM_DIR", vlm)
+    monkeypatch.setattr(main, "SHEETS_DIR", vlm / "verify")
+    monkeypatch.setattr(main, "SHEET_KEY", vlm / "verify_key.csv")
+    monkeypatch.setattr(main, "SCORE_CSV", vlm / "score.csv")
+    monkeypatch.setattr("src.pipeline.runner.get_project_root", lambda: tmp_path)
+    monkeypatch.setattr("src.vlm.client.analyze_frame", fake_response)
+    return tmp_path
+
+
+def test_full_flow_vlm_sheets_score_summary(project):
+    assert main.main(["--steps", "vlm", "--make-sheets"]) == 0
+
+    results = project / "results"
+    for condition in main.CONDITIONS:
+        assert (results / "vlm" / condition / "clip01.json").is_file()
+        assert (results / condition / "timing.csv").is_file()
+        assert (results / condition / "config_snapshot.json").is_file()
+    assert (results / "summary.csv").is_file()
+
+    with open(results / "vlm" / "verify_key.csv", newline="", encoding="utf-8") as f:
+        key = list(csv.DictReader(f))
+    assert sorted(row["condition"] for row in key) == sorted(main.CONDITIONS)
+
+    # Sheets carry no condition names; fill every checkable claim.
+    for row in key:
+        sheet = results / "vlm" / "verify" / f"{row['sheet']}.csv"
+        assert row["condition"] not in sheet.read_text(encoding="utf-8")
+        with open(sheet, newline="", encoding="utf-8") as f:
+            claims = list(csv.DictReader(f))
+        for claim in claims:
+            claim["label"] = "correct" if claim["checkability"] == "checkable" else "uncheckable"
+        with open(sheet, "w", newline="", encoding="utf-8") as f:
+            writer = csv.DictWriter(f, fieldnames=["claim", "checkability", "label"])
+            writer.writeheader()
+            writer.writerows(claims)
+
+    assert main.main(["--no-run", "--score"]) == 0
+
+    with open(results / "vlm" / "score.csv", newline="", encoding="utf-8") as f:
+        scores = list(csv.DictReader(f))
+    assert len(scores) == 3
+    assert all(row["scene_acc"] == "1.0" for row in scores)
+
+    with open(results / "summary.csv", newline="", encoding="utf-8") as f:
+        summary = {row["condition"]: row for row in csv.DictReader(f)}
+    assert summary["orig"]["vlm_scene_acc"] == "1.0"
+
+
+def test_offline_second_run_uses_cache(project, monkeypatch):
+    assert main.main(["--steps", "vlm"]) == 0
+
+    def must_not_run(*args, **kwargs):
+        raise AssertionError("VLM called in offline mode")
+
+    monkeypatch.setattr("src.vlm.client.analyze_frame", must_not_run)
+    assert main.main(["--steps", "vlm", "--offline"]) == 0
+
+
+def test_mismatched_frame_lists_stop_with_error(project):
+    (project / "data" / "frames" / "fixed" / "clip01_900.png").write_bytes(b"x")
+
+    assert main.main(["--steps", "vlm"]) == 1
+
+
+def test_missing_frames_folder_is_a_clear_error(project, capsys):
+    import shutil
+
+    shutil.rmtree(project / "data" / "frames" / "adaptive")
+
+    assert main.main(["--steps", "vlm"]) == 1
+    assert "Frames folder not found" in capsys.readouterr().err
diff --git a/tests/test_runner_fixes.py b/tests/test_runner_fixes.py
new file mode 100644
index 0000000..fd51823
--- /dev/null
+++ b/tests/test_runner_fixes.py
@@ -0,0 +1,108 @@
+import csv
+
+from src.pipeline.runner import (
+    _group_frames_by_clip,
+    add_timing_rows,
+    execute_experiment,
+    run_experiment,
+)
+from src.vlm.scoring import score_vlm
+
+
+def fake_response(*args, **kwargs):
+    return {"vehicles": ["car"], "events": [], "visibility_notes": [], "uncertain": []}
+
+
+def read_csv(path):
+    with open(path, newline="", encoding="utf-8") as file:
+        return list(csv.DictReader(file))
+
+
+def test_frames_sorted_by_number_not_text(tmp_path):
+    for ms in (100, 3500, 500):
+        (tmp_path / f"bdd_01_{ms}.png").write_bytes(b"x")
+
+    names = [p.name for p in _group_frames_by_clip(tmp_path)["bdd_01"]]
+
+    assert names == ["bdd_01_100.png", "bdd_01_500.png", "bdd_01_3500.png"]
+
+
+def test_config_snapshot_records_real_vlm_and_prompt(tmp_path, monkeypatch):
+    import hashlib
+    import json
+
+    from src.vlm.client import MODEL_NAME, SYSTEM_PROMPT
+
+    monkeypatch.setattr("src.pipeline.runner.get_project_root", lambda: tmp_path)
+
+    config = json.loads(open(run_experiment("orig")["config_path"], encoding="utf-8").read())
+
+    assert MODEL_NAME in config["model_versions"]["vlm"]
+    assert "not_configured" not in json.dumps(config)
+    assert config["prompt_hash"] == hashlib.sha256(SYSTEM_PROMPT.encode("utf-8")).hexdigest()
+
+
+def test_timing_keeps_old_rows_and_adds_new_frames(tmp_path):
+    row = {"frame": "a_1.png", "condition": "orig", "enhance_ms": "",
+           "ocr_ms": "", "vlm_ms": 5, "total_ms": 5}
+    add_timing_rows(tmp_path, [row])
+
+    _, added = add_timing_rows(tmp_path, [dict(row, vlm_ms=99), dict(row, frame="b_1.png")])
+
+    rows = read_csv(tmp_path / "timing.csv")
+    assert added == 1
+    assert [r["frame"] for r in rows] == ["a_1.png", "b_1.png"]
+    assert rows[0]["vlm_ms"] == "5"
+
+
+def test_second_run_adds_timing_for_new_clip(tmp_path, monkeypatch):
+    frames = tmp_path / "frames"
+    frames.mkdir()
+    (frames / "clip01_1.png").write_bytes(b"x")
+    monkeypatch.setattr("src.vlm.client.analyze_frame", fake_response)
+    results = tmp_path / "results"
+
+    execute_experiment("orig", ["vlm"], frames_dir=frames, results_dir=results)
+    (frames / "clip02_1.png").write_bytes(b"x")
+    execute_experiment("orig", ["vlm"], frames_dir=frames, results_dir=results)
+
+    rows = read_csv(results / "orig" / "timing.csv")
+    assert sorted(r["frame"] for r in rows) == ["clip01_1.png", "clip02_1.png"]
+
+
+def test_offline_never_calls_vlm(tmp_path, monkeypatch):
+    frames = tmp_path / "frames"
+    frames.mkdir()
+    (frames / "clip01_1.png").write_bytes(b"x")
+    (frames / "clip02_1.png").write_bytes(b"x")
+    results = tmp_path / "results"
+    (results / "vlm" / "orig").mkdir(parents=True)
+    (results / "vlm" / "orig" / "clip01.json").write_text("{}", encoding="utf-8")
+
+    def must_not_run(*args, **kwargs):
+        raise AssertionError("VLM called in offline mode")
+
+    monkeypatch.setattr("src.vlm.client.analyze_frame", must_not_run)
+
+    result = execute_experiment("orig", ["vlm"], frames_dir=frames,
+                                results_dir=results, offline=True)
+
+    assert result["skipped_clips"] == ["clip01"]
+    assert result["missing_clips"] == ["clip02"]
+    assert result["vlm"] == "offline_cache_incomplete"
+
+
+def test_score_csv_keeps_one_row_per_condition_and_clip(tmp_path):
+    sheet = tmp_path / "sheet.csv"
+    with open(sheet, "w", newline="", encoding="utf-8") as file:
+        writer = csv.DictWriter(file, fieldnames=["claim", "checkability", "label"])
+        writer.writeheader()
+        writer.writerow({"claim": "car", "checkability": "checkable", "label": "correct"})
+    out = tmp_path / "score.csv"
+
+    score_vlm(sheet, {}, out, condition="orig", clip="c1")
+    score_vlm(sheet, {}, out, condition="fixed", clip="c1")
+    score_vlm(sheet, {}, out, condition="orig", clip="c1")
+
+    rows = read_csv(out)
+    assert sorted((r["condition"], r["clip"]) for r in rows) == [("fixed", "c1"), ("orig", "c1")]
